{
  "name": "nami",
  "version": "1.0.8",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "next dev",
    "dev:electron": "wait-on tcp:3000 && tsc electron/main.ts electron/preload.ts electron/server.ts electron/tools/fs.ts electron/tools/definitions.ts electron/tools/lib/types.ts electron/tools/lib/utils.ts electron/tools/lib/scanner.ts electron/tools/lib/read.ts electron/tools/lib/write.ts electron/tools/lib/analyze.ts electron/tools/lib/undo.ts electron/tools/lib/automation.ts electron/tools/searchWorker.ts --outDir dist --target esnext --module commonjs --esModuleInterop --skipLibCheck && electron . --dev",
    "build": "next build && tsc electron/main.ts electron/preload.ts electron/server.ts electron/tools/fs.ts electron/tools/definitions.ts electron/tools/lib/types.ts electron/tools/lib/utils.ts electron/tools/lib/scanner.ts electron/tools/lib/read.ts electron/tools/lib/write.ts electron/tools/lib/analyze.ts electron/tools/lib/undo.ts electron/tools/lib/automation.ts electron/tools/searchWorker.ts --outDir dist --target esnext --module commonjs --esModuleInterop --skipLibCheck",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.nami.app",
    "productName": "Nami",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "directories": {
      "output": "dist_app"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "arm64"
      },
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "en"
      ]
    },
    "extraResources": [
      ".env"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.9",
    "@ai-sdk/react": "^3.0.35",
    "@hono/node-server": "^1.19.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@types/dagre": "^0.7.53",
    "ai": "^6.0.33",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "electron-serve": "^3.0.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.26.1",
    "get-port": "^7.1.0",
    "glob": "^13.0.0",
    "hono": "^4.11.4",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "next": "^16.1.1",
    "openai": "^6.18.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-virtuoso": "^4.18.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "trash": "^10.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  }
}
