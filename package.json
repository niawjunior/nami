{
  "name": "nami",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "next dev",
    "dev:electron": "wait-on tcp:3000 && tsc electron/main.ts electron/preload.ts electron/server.ts electron/tools/fs.ts --outDir dist --target esnext --module commonjs --esModuleInterop --skipLibCheck && electron . --dev",
    "build": "next build && tsc electron/main.ts electron/preload.ts electron/server.ts electron/tools/fs.ts --outDir dist --target esnext --module commonjs --esModuleInterop --skipLibCheck",
    "start": "electron .",
    "lint": "next lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "electron": "^39.2.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.9",
    "@ai-sdk/react": "^3.0.35",
    "@hono/node-server": "^1.19.8",
    "ai": "^6.0.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron-serve": "^3.0.0",
    "framer-motion": "^12.26.1",
    "get-port": "^7.1.0",
    "glob": "^13.0.0",
    "hono": "^4.11.4",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "next": "^16.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "trash": "^10.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  }
